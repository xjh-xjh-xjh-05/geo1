# ============================================
# 应用配置
# ============================================
APP_NAME=GEO虚假内容检测平台
APP_VERSION=1.0.0
DEBUG=true

# ============================================
# 数据库配置 - 必填
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geo_fake_detection
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================
# Redis配置 - 必填
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Kafka配置 - 必填
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DETECTION_TOPIC=geo-detection-requests
KAFKA_RESULT_TOPIC=geo-detection-results

# ============================================
# 安全配置 - 必填且SECRET_KEY至少32字符
# ============================================
SECRET_KEY=generate-a-secure-32-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS配置
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# ============================================
# 本地语义模型（可选）
# ============================================
# true 时加载 paraphrase-multilingual-MiniLM-L12-v2 并缓存到 models/cache。
# 下载/加载失败会自动回退到字符频率向量。
USE_SENTENCE_TRANSFORMER=false

# ============================================
# 配额配置
# ============================================
QUOTA_DEFAULT_DAILY=10000
QUOTA_DEFAULT_MONTHLY=300000

# ============================================
# 限流配置
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_PERIOD=60
